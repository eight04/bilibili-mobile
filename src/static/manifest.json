{
	"manifest_version": 2,
	"version": "0.8.0",
	"name": "__MSG_extensionName__",
	"description": "__MSG_extensionDescription__",
	"author": "eight",
	"homepage_url": "https://github.com/eight04/bilibili-mobile",
	"permissions": [
    "https://*.bilibili.com/*",
    "https://*.bilivideo.com/*",
    "webNavigation",
    "webRequest",
    "webRequestBlocking"
	],
	"optional_permissions": [
	],
	"background": {
		"scripts": []
	},
	"content_scripts": [
		{
			"matches": [
				"https://*.bilibili.com/*",
        "https://*.bilivideo.com/*"
			],
			"js": [],
      "css": [
        "css/common.css"
      ],
			"run_at": "document_start"
		},
    {
      "matches": [
        "https://*.bilibili.com/*",
        "https://*.bilivideo.com/*"
      ],
      "js": [
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://space.bilibili.com/*"
      ],
      "css": [
        "css/space.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://search.bilibili.com/*"
      ],
      "css": [
        "css/search.css"
      ],
      "run_at": "document_start"
    }
	],
	"default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "bilibili-mobile@eight04.github.io",
      "strict_min_version": "42.0"
    }
  }
}
